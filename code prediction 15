15. Predict the Output – Reverse Recursion
#include &lt;stdio.h&gt;
void fun(int n) {
if(n == 0)
return;
fun(n - 1);
printf(&quot;%d &quot;, n);
}
int main() {
fun(5);
return 0;
}
